# Supabase (required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Function secrets
# Set these via Supabase Dashboard > Edge Functions > Secrets, or with:
#   supabase secrets set VOLUUM_ACCESS_ID=xxx VOLUUM_ACCESS_KEY=xxx BID_FEED_TOKEN=xxx
#
# VOLUUM_ACCESS_ID=your-voluum-access-id
# VOLUUM_ACCESS_KEY=your-voluum-access-key
# VOLUUM_API_BASE=https://api.voluum.com
# VOLUUM_TIMEZONE=Asia/Bangkok
# VOLUUM_CACHE_TTL_SECONDS=300
# BID_FEED_TOKEN=your-random-feed-token
# BID_FEED_ENABLED=false
